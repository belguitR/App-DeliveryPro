<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Inheritance du Spring Boot Starter Parent -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.4</version>
	</parent>

	<groupId>fr.uga.miage.l3</groupId>
	<artifactId>backend</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Spring Boot Data JPA Sample</name>
	<description>Spring Boot Data JPA Sample</description>

	<modules>
		<module>server</module>
		<module>rest-api</module>
	</modules>

	<properties>
		<lombok.version>1.18.30</lombok.version>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Pour OpenAPI 3, on utilise les annotations de io.swagger.core.v3 -->
		<swagger-annotation.version>2.2.8</swagger-annotation.version>
		<!-- Version de SpringDoc Starter adaptée à Spring Boot 3 -->
		<springDoc.version>2.1.0</springDoc.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Swagger Annotations pour OpenAPI 3 -->
			<dependency>
				<groupId>io.swagger.core.v3</groupId>
				<artifactId>swagger-annotations</artifactId>
				<version>${swagger-annotation.version}</version>
			</dependency>
			<!-- SpringDoc Starter WebMVC UI pour générer Swagger UI -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springDoc.version}</version>
			</dependency>
			<!-- PostgreSQL -->
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>42.7.5</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-security</artifactId>
				<version>3.2.0</version> <!-- 👈 what's yours? -->
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
